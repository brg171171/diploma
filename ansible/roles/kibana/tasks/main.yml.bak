---
- name: Validate Kibana variables
  ansible.builtin.assert:
    that:
      - elasticsearch_host is defined
      - elasticsearch_host | length > 0
      - kibana_host is defined
      - kibana_host | length > 0
      - vault_elasticsearch_password is defined
      - vault_elasticsearch_password | length >= 12
      - vault_kibana_system_password is defined
      - vault_kibana_system_password | length >= 12
      - vault_kibana_security_encryption_key is defined
      - vault_kibana_security_encryption_key | length >= 32
      - vault_kibana_saved_objects_encryption_key is defined
      - vault_kibana_saved_objects_encryption_key | length >= 32
      - vault_kibana_reporting_encryption_key is defined
      - vault_kibana_reporting_encryption_key | length >= 32
    fail_msg: >-
      Define Elasticsearch/Kibana hosts, passwords and three Kibana encryption
      keys of at least 32 characters.
  no_log: true

- name: Install Kibana package prerequisites
  ansible.builtin.apt:
    name:
      - ca-certificates
      - curl
    state: present
    update_cache: true
    cache_valid_time: 3600

- name: Read installed Kibana version
  ansible.builtin.command:
    argv:
      - dpkg-query
      - -W
      - -f=${Version}
      - kibana
  register: kibana_installed_version
  changed_when: false
  failed_when: false

- name: Download Kibana package with SHA-512 verification
  ansible.builtin.get_url:
    url: "{{ kibana_deb_url }}"
    dest: "{{ kibana_deb_path }}"
    checksum: "sha512:{{ kibana_deb_url }}.sha512"
    mode: "0644"
  when: kibana_stack_version_missing
  vars:
    kibana_stack_version_missing: >-
      {{ kibana_installed_version.rc != 0 or
         elastic_stack_version not in kibana_installed_version.stdout }}

- name: Install requested Kibana version
  ansible.builtin.apt:
    deb: "{{ kibana_deb_path }}"
    state: present
    allow_downgrade: true
  when: kibana_stack_version_missing
  vars:
    kibana_stack_version_missing: >-
      {{ kibana_installed_version.rc != 0 or
         elastic_stack_version not in kibana_installed_version.stdout }}
  notify: Restart Kibana

- name: Install Kibana configuration
  ansible.builtin.template:
    src: kibana.yml.j2
    dest: /etc/kibana/kibana.yml
    owner: root
    group: kibana
    mode: "0640"
  no_log: true
  notify: Restart Kibana

- name: Apply pending Kibana restart
  ansible.builtin.meta: flush_handlers

- name: Enable and start Kibana
  ansible.builtin.systemd_service:
    name: kibana
    state: started
    enabled: true
    daemon_reload: true

- name: Wait for Kibana TCP port
  ansible.builtin.wait_for:
    host: 127.0.0.1
    port: "{{ kibana_port }}"
    delay: 5
    timeout: 300

- name: Wait for Kibana API
  ansible.builtin.uri:
    url: "http://127.0.0.1:{{ kibana_port }}/api/status"
    method: GET
    user: elastic
    password: "{{ vault_elasticsearch_password }}"
    force_basic_auth: true
    status_code: 200
  register: kibana_api_ready
  retries: 40
  delay: 5
  until: kibana_api_ready.status == 200
  no_log: true

- name: Check managed Nginx data view
  ansible.builtin.uri:
    url: >-
      http://127.0.0.1:{{ kibana_port }}/api/data_views/data_view/{{ kibana_data_view_id }}
    method: GET
    user: elastic
    password: "{{ vault_elasticsearch_password }}"
    force_basic_auth: true
    headers:
      kbn-xsrf: ansible
    status_code:
      - 200
      - 404
  register: kibana_data_view_state
  no_log: true

- name: Create managed Nginx data view
  ansible.builtin.uri:
    url: "http://127.0.0.1:{{ kibana_port }}/api/data_views/data_view"
    method: POST
    user: elastic
    password: "{{ vault_elasticsearch_password }}"
    force_basic_auth: true
    headers:
      kbn-xsrf: ansible
    body_format: json
    body:
      data_view:
        id: "{{ kibana_data_view_id }}"
        name: "{{ kibana_data_view_name }}"
        title: "{{ kibana_data_view_pattern }}"
        timeFieldName: "{{ kibana_data_view_time_field }}"
        allowNoIndex: true
    status_code: 200
  when: kibana_data_view_state.status == 404
  no_log: true

- name: Set Nginx data view as default
  ansible.builtin.uri:
    url: "http://127.0.0.1:{{ kibana_port }}/api/data_views/default"
    method: POST
    user: elastic
    password: "{{ vault_elasticsearch_password }}"
    force_basic_auth: true
    headers:
      kbn-xsrf: ansible
    body_format: json
    body:
      data_view_id: "{{ kibana_data_view_id }}"
      force: true
    status_code: 200
  no_log: true

