global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090
        labels:
          environment: diploma

  - job_name: node_exporter
    file_sd_configs:
      - files:
          - "{{ prometheus_file_sd_dir }}/node-exporter.json"
        refresh_interval: 30s

  - job_name: nginxlog_exporter
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - "{{ prometheus_file_sd_dir }}/nginxlog-exporter.json"
        refresh_interval: 30s
