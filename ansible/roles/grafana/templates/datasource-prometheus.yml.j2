apiVersion: 1

deleteDatasources:
  - name: Prometheus
    orgId: 1

datasources:
  - name: Prometheus
    uid: {{ grafana_prometheus_uid }}
    type: prometheus
    access: proxy
    orgId: 1
    url: {{ grafana_prometheus_url }}
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      manageAlerts: true
      prometheusType: Prometheus
      prometheusVersion: 2.45.0
      cacheLevel: High
      timeInterval: 15s

