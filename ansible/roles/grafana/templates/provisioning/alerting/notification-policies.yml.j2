---
apiVersion: 1

policies:
  - orgId: 1
    receiver: diploma-email

    group_by:
      - grafana_folder
      - alertname
      - severity

    group_wait: 10s
    group_interval: 1m
    repeat_interval: 12h

    routes:
      - receiver: diploma-email
        object_matchers:
          - - severity
            - =
            - critical
        group_wait: 10s
        group_interval: 1m
        repeat_interval: 30m

      - receiver: diploma-email
        object_matchers:
          - - severity
            - =
            - warning
        group_wait: 30s
        group_interval: 5m
        repeat_interval: 4h
