[server]
protocol = http
http_addr = {{ grafana_http_addr }}
http_port = {{ grafana_http_port }}
{% if grafana_domain | length > 0 %}
domain = {{ grafana_domain }}
{% endif %}

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
disable_gravatar = true
cookie_secure = false
cookie_samesite = strict

[users]
allow_sign_up = {{ grafana_allow_sign_up | bool | lower }}
allow_org_create = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[unified_alerting]
enabled = true

[log]
mode = console file
level = info

[paths]
provisioning = /etc/grafana/provisioning

#################################### SMTP ####################################

[smtp]
enabled = {{ grafana_smtp_enabled | bool | lower }}
host = {{ grafana_smtp_host }}
user = {{ grafana_smtp_user }}
password = {{ vault_alertmanager_smtp_app_password }}
skip_verify = false
from_address = {{ grafana_smtp_from_address }}
from_name = {{ grafana_smtp_from_name }}
startTLS_policy = MandatoryStartTLS

[emails]
welcome_email_on_sign_up = false