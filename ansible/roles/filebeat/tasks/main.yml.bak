---
- name: Validate Filebeat connection and credential source
  ansible.builtin.assert:
    that:
      - elasticsearch_host is defined
      - elasticsearch_host | length > 0
      - filebeat_credentials_source in ["vault", "lockbox"]
      - >-
        filebeat_credentials_source != "lockbox" or
        filebeat_lockbox_secret_id | length > 0
      - >-
        filebeat_credentials_source != "vault" or
        (vault_filebeat_password | default("") | length >= 12)
      - >-
        not (filebeat_manage_assets | bool) or
        (vault_elasticsearch_password | default("") | length >= 12)
    fail_msg: >-
      Define elasticsearch_host and either filebeat_lockbox_secret_id or
      vault_filebeat_password. Asset setup additionally requires
      vault_elasticsearch_password.
  no_log: true

- name: Get IAM token from the VM metadata service
  ansible.builtin.uri:
    url: >-
      http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
    method: GET
    headers:
      Metadata-Flavor: Google
    return_content: true
    use_proxy: false
    status_code: 200
  register: filebeat_instance_iam_token
  retries: 10
  delay: 3
  until: filebeat_instance_iam_token.status == 200
  when: filebeat_credentials_source == "lockbox"
  no_log: true

- name: Get the restricted Filebeat password from Yandex Lockbox
  ansible.builtin.uri:
    url: >-
      https://payload.lockbox.api.cloud.yandex.net/lockbox/v1/secrets/{{ filebeat_lockbox_secret_id }}/payload
    method: GET
    headers:
      Authorization: "Bearer {{ filebeat_instance_iam_token.json.access_token }}"
    return_content: true
    status_code: 200
  register: filebeat_lockbox_payload
  retries: 10
  delay: 3
  until: filebeat_lockbox_payload.status == 200
  when: filebeat_credentials_source == "lockbox"
  no_log: true

- name: Select Filebeat password from Lockbox payload
  ansible.builtin.set_fact:
    filebeat_effective_password: >-
      {{
        filebeat_lockbox_payload.json.entries
        | selectattr("key", "equalto", filebeat_lockbox_secret_key)
        | map(attribute="textValue")
        | first
      }}
  when: filebeat_credentials_source == "lockbox"
  no_log: true

- name: Select Filebeat password from Ansible Vault
  ansible.builtin.set_fact:
    filebeat_effective_password: "{{ vault_filebeat_password }}"
  when: filebeat_credentials_source == "vault"
  no_log: true

- name: Validate resolved Filebeat password
  ansible.builtin.assert:
    that:
      - filebeat_effective_password is defined
      - filebeat_effective_password | length >= 12
    fail_msg: >-
      Filebeat password was not resolved. Verify the Lockbox secret ID, key,
      service-account attachment and lockbox.payloadViewer permission.
  no_log: true

- name: Install Filebeat package prerequisites
  ansible.builtin.apt:
    name:
      - ca-certificates
      - curl
    state: present
    update_cache: true
    cache_valid_time: 3600

- name: Read installed Filebeat version
  ansible.builtin.command:
    argv:
      - dpkg-query
      - -W
      - -f=${Version}
      - filebeat
  register: filebeat_installed_version
  changed_when: false
  failed_when: false

- name: Download Filebeat package with SHA-512 verification
  ansible.builtin.get_url:
    url: "{{ filebeat_deb_url }}"
    dest: "{{ filebeat_deb_path }}"
    checksum: "sha512:{{ filebeat_deb_url }}.sha512"
    mode: "0644"
  when: filebeat_stack_version_missing
  vars:
    filebeat_stack_version_missing: >-
      {{ filebeat_installed_version.rc != 0 or
         elastic_stack_version not in filebeat_installed_version.stdout }}

- name: Install requested Filebeat version
  ansible.builtin.apt:
    deb: "{{ filebeat_deb_path }}"
    state: present
    allow_downgrade: true
  when: filebeat_stack_version_missing
  vars:
    filebeat_stack_version_missing: >-
      {{ filebeat_installed_version.rc != 0 or
         elastic_stack_version not in filebeat_installed_version.stdout }}
  notify: Restart Filebeat

- name: Install Filebeat configuration
  ansible.builtin.template:
    src: filebeat.yml.j2
    dest: /etc/filebeat/filebeat.yml
    owner: root
    group: root
    mode: "0600"
  no_log: true
  notify: Restart Filebeat

- name: Install enabled Nginx module configuration
  ansible.builtin.template:
    src: nginx.yml.j2
    dest: /etc/filebeat/modules.d/nginx.yml
    owner: root
    group: root
    mode: "0644"
  notify: Restart Filebeat

- name: Disable packaged Nginx module example
  ansible.builtin.file:
    path: /etc/filebeat/modules.d/nginx.yml.disabled
    state: absent

- name: Validate Filebeat configuration
  ansible.builtin.command:
    argv:
      - /usr/bin/filebeat
      - test
      - config
      - -c
      - /etc/filebeat/filebeat.yml
  changed_when: false
  no_log: true

- name: Check Filebeat asset setup marker
  ansible.builtin.stat:
    path: "{{ filebeat_setup_marker }}"
  register: filebeat_setup_state
  when: filebeat_manage_assets | bool

- name: Load Filebeat Nginx ingest pipelines
  ansible.builtin.command:
    argv:
      - /usr/bin/filebeat
      - setup
      - --pipelines
      - --modules
      - nginx
      - --force-enable-module-filesets
      - -E
      - "output.elasticsearch.username=elastic"
      - -E
      - "output.elasticsearch.password={{ vault_elasticsearch_password }}"
  when:
    - filebeat_manage_assets | bool
    - not (filebeat_setup_state.stat.exists | default(false))
  no_log: true

- name: Load Filebeat index management assets
  ansible.builtin.command:
    argv:
      - /usr/bin/filebeat
      - setup
      - --index-management
      - -E
      - "output.elasticsearch.username=elastic"
      - -E
      - "output.elasticsearch.password={{ vault_elasticsearch_password }}"
  when:
    - filebeat_manage_assets | bool
    - not (filebeat_setup_state.stat.exists | default(false))
  no_log: true

- name: Mark Filebeat asset setup complete
  ansible.builtin.file:
    path: "{{ filebeat_setup_marker }}"
    state: touch
    owner: root
    group: root
    mode: "0600"
    modification_time: preserve
    access_time: preserve
  when:
    - filebeat_manage_assets | bool
    - not (filebeat_setup_state.stat.exists | default(false))

- name: Apply pending Filebeat restart
  ansible.builtin.meta: flush_handlers

- name: Enable and start Filebeat
  ansible.builtin.systemd_service:
    name: filebeat
    state: started
    enabled: true
    daemon_reload: true

- name: Test Filebeat connection to Elasticsearch
  ansible.builtin.command:
    argv:
      - /usr/bin/filebeat
      - test
      - output
      - -c
      - /etc/filebeat/filebeat.yml
  register: filebeat_output_test
  changed_when: false
  no_log: true
