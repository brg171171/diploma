#cloud-config
preserve_hostname: false
manage_etc_hosts: true
timezone: ${timezone_yaml}

users:
  - name: ${ssh_user_yaml}
    gecos: Diploma administrator
    groups:
      - adm
      - sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key_yaml}

disable_root: true
ssh_pwauth: false

package_update: true
package_upgrade: false
packages:
  - ca-certificates
  - curl
  - git
  - jq
  - nginx
  - python3
  - python3-apt
  - unzip

write_files:
  - path: /etc/diploma/instance.yml
    owner: root:root
    permissions: "0644"
    content: |
      project: ${project_name_yaml}
      role: web
      provisioner: cloud-init

  - path: /var/www/html/index.html
    owner: root:www-data
    permissions: "0644"
    content: |
      <!doctype html>
      <html lang="ru">
        <head>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width,initial-scale=1">
          <title>Netology Diploma</title>
        </head>
        <body>
          <h1>Web server is ready</h1>
          <p>Project: ${project_name_yaml}</p>
        </body>
      </html>

  - path: /etc/ssh/sshd_config.d/99-diploma-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      X11Forwarding no
      AllowTcpForwarding yes

runcmd:
  - [nginx, -t]
  - [systemctl, enable, --now, nginx]
  - [systemctl, reload, ssh]
  - [cloud-init-per, once, diploma-ready, touch, /var/lib/diploma-cloud-init-ready]

final_message: "Cloud-init completed for web instance"
