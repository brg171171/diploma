#cloud-config
preserve_hostname: false
manage_etc_hosts: true
timezone: ${timezone_yaml}

users:
  - name: ${ssh_user_yaml}
    gecos: Diploma administrator
    groups:
      - adm
      - sudo
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key_yaml}

disable_root: true
ssh_pwauth: false

package_update: true
package_upgrade: false
packages:
  - ansible
  - ca-certificates
  - curl
  - git
  - jq
  - nginx
  - python3
  - python3-apt
  - rsync
  - unzip

write_files:
  - path: /etc/diploma/instance.yml
    owner: root:root
    permissions: "0644"
    content: |
      project: ${project_name_yaml}
      role: web
      provisioner: cloud-init

  - path: /var/www/html/index.html
    owner: root:www-data
    permissions: "0644"
    content: |
      <!doctype html>
      <html lang="ru">
        <head>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width,initial-scale=1">
          <title>Netology Diploma</title>
        </head>
        <body>
          <h1>Web server is ready</h1>
          <p>Project: ${project_name_yaml}</p>
        </body>
      </html>

  - path: /etc/ssh/sshd_config.d/99-diploma-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      X11Forwarding no
      AllowTcpForwarding yes

  - path: /usr/local/sbin/diploma-ansible-pull
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      REPO_URL=${git_repo_url_shell}
      REVISION=${git_revision_shell}
      REPO_DIR="/opt/diploma"

      if [[ -z "$REPO_URL" ]]; then
        echo "git_repo_url is empty" >&2
        exit 2
      fi

      export HOME="/root"
      export ANSIBLE_CONFIG="$REPO_DIR/ansible/ansible.cfg"
      export ANSIBLE_ROLES_PATH="$REPO_DIR/ansible/roles"
      export ANSIBLE_LOCAL_TEMP="/tmp/ansible-local"

      mkdir -p "$ANSIBLE_LOCAL_TEMP"

      exec /usr/bin/ansible-pull \
        --url "$REPO_URL" \
        --checkout "$REVISION" \
        --directory "$REPO_DIR" \
        --inventory "localhost," \
        ansible/playbooks/web-pull.yml

  - path: /etc/systemd/system/diploma-ansible-pull.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Configure diploma web server using ansible-pull
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/diploma-ansible-pull
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/diploma-ansible-pull.timer
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Periodically update diploma web server configuration

      [Timer]
      OnBootSec=10min
      OnUnitActiveSec=30min
      RandomizedDelaySec=60
      Persistent=true
      Unit=diploma-ansible-pull.service

      [Install]
      WantedBy=timers.target

runcmd:
  - [nginx, -t]
  - [systemctl, enable, --now, nginx]
  - [ansible-galaxy, collection, install, ansible.posix, community.general]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, diploma-ansible-pull.timer]
  - [systemctl, start, diploma-ansible-pull.service]
  - [systemctl, reload, ssh]
  - [cloud-init-per, once, diploma-ready, touch, /var/lib/diploma-cloud-init-ready]
  - [cloud-init-per, once, diploma-ready, touch, /var/lib/cloud/diploma-ready]


final_message: "Cloud-init completed for web instance"
